generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
}

enum AIProviderType {
  OLLAMA
  OPENAI
}

enum AIInteractionStatus {
  SUCCESS
  INVALID_OUTPUT
  ERROR
}

enum VisualProposalStatus {
  ANALYZED
  GENERATED
  ERROR
}

enum VisualProposalMode {
  NEUTRAL
  CONTEXTUAL
}

enum ProductPricingMode {
  CUSTOM_COMPLEX
  FIXED
}

enum ConversationChannel {
  WEB
  WHATSAPP
}

enum ConversationStatus {
  COLLECTING
  READY_TO_QUOTE
  QUOTING
  QUOTED
  HANDOFF
  CLOSED
  ERROR
}

enum ConversationMessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationMessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  SYSTEM
}

enum ConversationMessageStatus {
  RECEIVED
  BUFFERED
  PROCESSED
  SENT
  FAILED
}

model Tenant {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  currency        String           @default("PEN")
  igvPercent      Decimal          @default(18) @db.Decimal(5, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  customers       Customer[]
  products        Product[]
  priceRules      PriceRule[]
  quotes          Quote[]
  attachments     Attachment[]
  aiInteractions  AIInteraction[]
  visualProposals VisualProposal[]
  conversations   Conversation[]
  auditLogs       AuditLog[]
  contactProfiles ContactProfile[]
  jobs            Job[]
  tasks           Task[]
  approvals       Approval[]
  summaries       ConversationSummary[]
  productConfigurations ProductConfiguration[]
  agentTurns AgentTurn[]
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  email     String
  name      String
  role      String     @default("OWNER")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  email     String?
  company   String?
  district  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes    Quote[]
  contactProfiles ContactProfile[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
}

model Product {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  name        String
  slug        String
  category    String
  description String?
  unit        String             @default("unidad")
  isActive    Boolean            @default(true)
  pricingMode ProductPricingMode @default(CUSTOM_COMPLEX)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceRules  PriceRule[]
  quoteItems  QuoteItem[]
  configurations ProductConfiguration[]
  jobs Job[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, category])
}

model Conversation {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @db.Uuid
  channel              ConversationChannel
  externalId           String
  customerName         String?
  customerPhone        String?
  status               ConversationStatus    @default(COLLECTING)
  greetedAt            DateTime?
  spacePhotoAskedAt    DateTime?
  spacePhotoDeclinedAt DateTime?
  lastInboundAt        DateTime?
  lastProcessedAt      DateTime?
  context              Json                  @default("{}")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages             ConversationMessage[]
  jobs                 Job[]
  tasks                Task[]
  summaries            ConversationSummary[]
  agentTurns           AgentTurn[]

  @@unique([tenantId, id])
  @@unique([tenantId, channel, externalId])
  @@index([tenantId, status, lastInboundAt])
}

model ConversationMessage {
  id                String                       @id @default(uuid()) @db.Uuid
  conversationId    String                       @db.Uuid
  externalMessageId String?
  direction         ConversationMessageDirection
  type              ConversationMessageType
  text              String?
  mediaId           String?
  mimeType          String?
  fileName          String?
  status            ConversationMessageStatus    @default(RECEIVED)
  processedAt       DateTime?
  payload           Json?
  createdAt         DateTime                     @default(now())
  conversation      Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnMemberships   AgentTurnMessage[]

  @@unique([conversationId, id])
  @@unique([conversationId, externalMessageId])
  @@index([conversationId, direction, status, createdAt])
}

model PriceRule {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @db.Uuid
  productId           String      @db.Uuid
  name                String
  basePrice           Decimal     @default(0) @db.Decimal(12, 2)
  pricePerSquareMeter Decimal     @default(0) @db.Decimal(12, 2)
  designFee           Decimal     @default(0) @db.Decimal(12, 2)
  installationFee     Decimal     @default(0) @db.Decimal(12, 2)
  transportFee        Decimal     @default(0) @db.Decimal(12, 2)
  marginPercent       Decimal     @default(0) @db.Decimal(5, 2)
  igvPercent          Decimal     @default(18) @db.Decimal(5, 2)
  isDemo              Boolean     @default(true)
  isActive            Boolean     @default(true)
  validFrom           DateTime    @default(now())
  validUntil          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quoteItems          QuoteItem[]

  @@index([tenantId, productId, isActive])
}

model Quote {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  customerId        String           @db.Uuid
  number            String
  status            QuoteStatus      @default(DRAFT)
  sourceText        String?
  notes             String?
  designBrief       String?
  installationNotes String?
  serviceAddress    String?
  currency          String           @default("PEN")
  subtotal          Decimal          @default(0) @db.Decimal(12, 2)
  discount          Decimal          @default(0) @db.Decimal(12, 2)
  tax               Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @default(0) @db.Decimal(12, 2)
  validUntil        DateTime?
  approvedAt        DateTime?
  workflowSnapshot  Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             QuoteItem[]
  attachments       Attachment[]
  aiInteractions    AIInteraction[]
  visualProposals   VisualProposal[]
  jobs              Job[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
}

model QuoteItem {
  id               String     @id @default(uuid()) @db.Uuid
  quoteId          String     @db.Uuid
  productId        String     @db.Uuid
  priceRuleId      String?    @db.Uuid
  description      String
  quantity         Decimal    @default(1) @db.Decimal(10, 2)
  widthM           Decimal?   @db.Decimal(10, 3)
  heightM          Decimal?   @db.Decimal(10, 3)
  areaM2           Decimal?   @db.Decimal(12, 4)
  unitPrice        Decimal    @db.Decimal(12, 2)
  subtotal         Decimal    @db.Decimal(12, 2)
  pricingBreakdown Json
  createdAt        DateTime   @default(now())
  quote            Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceRule        PriceRule? @relation(fields: [priceRuleId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  quoteId      String?  @db.Uuid
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  kind         String   @default("REFERENCE")
  description  String?
  aiConsent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote        Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([tenantId, quoteId])
}

model AIInteraction {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  quoteId    String?             @db.Uuid
  provider   AIProviderType
  model      String
  status     AIInteractionStatus
  inputText  String
  outputJson Json?
  error      String?
  durationMs Int?
  createdAt  DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote      Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model VisualProposal {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  quoteId           String?              @db.Uuid
  description       String
  mode              VisualProposalMode?
  spacePhotoConsent Boolean              @default(false)
  logoOriginalName  String
  logoMimeType      String
  logoStorageKey    String
  spaceMimeType     String?
  spaceStorageKey   String?
  outputStorageKey  String?
  analysis          Json?
  status            VisualProposalStatus @default(ANALYZED)
  error             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote             Quote?               @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([quoteId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
}

enum ContactProfileType {
  LEAD
  CLIENTE
  CLIENTE_FRECUENTE
  EMPRESA
  PROVEEDOR
  INTERNO
  OTRO
}

enum JobStatus {
  NUEVO
  CONSULTANDO
  RECOPILANDO_DATOS
  LISTO_PARA_COTIZAR
  REQUIERE_REVISION
  COTIZADO
  ESPERANDO_CLIENTE
  ACEPTADO
  ESPERANDO_ADELANTO
  PAGO_POR_CONFIRMAR
  PAGO_CONFIRMADO
  EN_PRODUCCION
  FECHA_PENDIENTE
  LISTO_PARA_RECOGER
  ENTREGADO
  PAUSADO
  CANCELADO
  REQUIERE_HUMANO
}

enum TaskType {
  CONFIRM_PAYMENT
  APPROVE_QUOTE
  SET_DELIVERY_DATE
  REQUEST_EARLIER_DELIVERY
  VERIFY_ARTWORK
  CONTACT_CUSTOMER
  FOLLOW_UP
  CHECK_REQUIREMENT
  HANDLE_COMPLAINT
  CALL_BACK_CUSTOMER
  CHECK_PRODUCT_RULE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ApprovalType {
  QUOTE
  PAYMENT
  DELIVERY_DATE
  DISCOUNT
  SPECIAL_PRICE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContactProfile {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  customerId  String? @db.Uuid
  phone       String
  name        String?
  company     String?
  type        ContactProfileType @default(LEAD)
  preferences Json @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer    Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  jobs        Job[]
  summaries   ConversationSummary[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, type, name])
}

model Job {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  contactProfileId  String @db.Uuid
  conversationId    String? @db.Uuid
  quoteId           String? @db.Uuid
  productId         String? @db.Uuid
  title             String
  status            JobStatus @default(NUEVO)
  requirements      Json @default("{}")
  confirmedReadyAt  DateTime?
  deliveredAt       DateTime?
  artworkApprovedAt DateTime?
  requirementsRevision Int @default(0)
  originKey         String?
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contactProfile    ContactProfile @relation(fields: [tenantId, contactProfileId], references: [tenantId, id], onDelete: Restrict)
  conversation      Conversation? @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  quote             Quote? @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  product           Product? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  tasks             Task[]
  approvals         Approval[]
  events            JobEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, contactProfileId, status])
  @@unique([tenantId, originKey])
  @@index([tenantId, confirmedReadyAt])
}

model JobEvent {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  jobId       String @db.Uuid
  eventKey    String
  type        String
  actorId     String
  actorRole   String
  evidence    String
  fromStatus  JobStatus
  toStatus    JobStatus
  payload     Json @default("{}")
  createdAt   DateTime @default(now())
  job         Job @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, eventKey])
  @@index([tenantId, jobId, createdAt])
}

model Task {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  jobId          String? @db.Uuid
  conversationId String? @db.Uuid
  type           TaskType
  status         TaskStatus @default(OPEN)
  title          String
  details        Json @default("{}")
  dedupeKey      String
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job            Job? @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Restrict)
  conversation   Conversation? @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, dueAt])
}

model Approval {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  jobId       String @db.Uuid
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  payload     Json @default("{}")
  dedupeKey   String
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job         Job @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, type])
}

model ConversationSummary {
  id                 String @id @default(uuid()) @db.Uuid
  tenantId           String @db.Uuid
  conversationId     String @db.Uuid
  contactProfileId   String @db.Uuid
  version            Int
  text               String
  sourceMessageIds   Json
  createdAt          DateTime @default(now())
  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation       Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  contactProfile     ContactProfile @relation(fields: [tenantId, contactProfileId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, conversationId, version])
}

// Immutable approved snapshots: the highest version is the current configuration.
model ProductConfiguration {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @db.Uuid
  productId  String @db.Uuid
  version    Int
  rules      Json
  updatedBy  String
  createdAt  DateTime @default(now())
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, productId, version])
}

enum AgentTurnStatus {
  IN_PROGRESS
  COMPLETED
  REQUIRES_REVIEW
  CANCELLED
}

enum AgentOutboxStatus {
  PENDING
  SENDING
  SENT
  UNCERTAIN
  FAILED
  CANCELLED
}

model AgentTurn {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @db.Uuid
  conversationId   String @db.Uuid
  status           AgentTurnStatus @default(IN_PROGRESS)
  sourceMessageIds Json
  leaseOwner       String @db.Uuid
  leaseUntil       DateTime
  attempts         Int @default(1)
  plan             Json?
  result           Json?
  failureCode      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation     Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  sourceMessages   AgentTurnMessage[]
  toolCalls        AgentToolCall[]
  outbox           AgentOutbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, id])
  @@index([tenantId, conversationId, status, createdAt])
}

// A persisted inbound message belongs to only one turn, including across retries/replicas.
model AgentTurnMessage {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  conversationId String @db.Uuid
  turnId         String @db.Uuid
  messageId      String @db.Uuid
  turn           AgentTurn @relation(fields: [tenantId, conversationId, turnId], references: [tenantId, conversationId, id], onDelete: Restrict)
  message        ConversationMessage @relation(fields: [conversationId, messageId], references: [conversationId, id], onDelete: Restrict)

  @@unique([tenantId, messageId])
  @@index([turnId])
}

model AgentToolCall {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @db.Uuid
  turnId     String @db.Uuid
  callId     String
  request    Json
  result     Json
  createdAt  DateTime @default(now())
  turn       AgentTurn @relation(fields: [tenantId, turnId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, turnId, callId])
}

model AgentOutbox {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  turnId            String @db.Uuid
  conversationId    String @db.Uuid
  sequence          Int
  type              ConversationMessageType
  payload           Json
  status            AgentOutboxStatus @default(PENDING)
  leaseOwner        String? @db.Uuid
  leaseUntil        DateTime?
  externalMessageId String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  turn              AgentTurn @relation(fields: [tenantId, conversationId, turnId], references: [tenantId, conversationId, id], onDelete: Restrict)

  @@unique([tenantId, turnId, sequence])
  @@index([tenantId, status, createdAt])
}
